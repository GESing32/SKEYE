<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>NDVI Predictor — Web</title>
  <style>
    :root{
      --bg:#0f1115; --panel:#171a21; --muted:#a9b1bd; --text:#e6edf3; --accent:#6ee7b7; --accent-2:#34d399; --danger:#f43f5e;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{margin:0;background:radial-gradient(1200px 600px at 10% -10%, #1b2229 0%, #0f1115 60%), var(--bg);color:var(--text);font:16px/1.45 system-ui, -apple-system, Segoe UI, Roboto, Arial, Noto Sans, "Apple Color Emoji","Segoe UI Emoji"}
    .wrap{max-width:960px;margin:32px auto;padding:0 16px}
    .card{background:linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));border:1px solid rgba(255,255,255,0.08);border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.35);padding:20px}
    h1{margin:0 0 4px;font-size:28px}
    .sub{color:var(--muted);margin-bottom:18px}
    .grid{display:grid;grid-template-columns:1fr;gap:16px}
    @media(min-width:840px){.grid{grid-template-columns:1fr 1fr}}

    .panel{background:var(--panel);border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:16px}
    label{font-weight:600;display:block;margin-bottom:8px}
    input[type="text"], .fileline{width:100%;border:1px dashed rgba(255,255,255,0.18);background:#12151b;border-radius:10px;padding:12px 14px;color:var(--text)}
    input[type="text"]{outline:none}
    .hint{color:var(--muted);font-size:12px}
    .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    button{appearance:none;border:0;background:linear-gradient(90deg,var(--accent),var(--accent-2));color:#0a0f0a;font-weight:700;padding:12px 16px;border-radius:10px;cursor:pointer;transition:transform .06s ease, filter .2s ease}
    button:disabled{filter:grayscale(1) brightness(.7);cursor:not-allowed}
    button:hover:not(:disabled){transform:translateY(-1px)}

    .status{display:inline-flex;align-items:center;gap:8px}
    .dot{width:10px;height:10px;border-radius:50%}
    .ok{background:#22c55e}.bad{background:var(--danger)}.warn{background:#eab308}

    .results{margin-top:16px}
    .pill{display:inline-block;background:#0f1419;border:1px solid rgba(255,255,255,0.08);padding:8px 10px;border-radius:999px;font-weight:600}

    .bar{height:10px;border-radius:999px;background:#0c1117;border:1px solid rgba(255,255,255,0.06);overflow:hidden}
    .bar>div{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-2));width:0}

    .error{padding:12px;border-radius:10px;background:rgba(244,63,94,.12);border:1px solid rgba(244,63,94,.35);color:#fecaca}
    .ghost{opacity:.6}
    .mt8{margin-top:8px}.mt12{margin-top:12px}.mt16{margin-top:16px}.mt24{margin-top:24px}

    .filebox{display:flex;gap:12px;flex-wrap:wrap}
    .file{
      position:relative;display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px dashed rgba(255,255,255,0.18);border-radius:10px;background:#12151b;min-width:260px
    }
    .file input{display:none}
    .file .name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
    .file .pick{padding:8px 10px;border-radius:8px;background:#0c1117;border:1px solid rgba(255,255,255,0.1);color:var(--text);cursor:pointer}
    .spin{inline-size:18px;block-size:18px;border-radius:50%;border:2px solid rgba(255,255,255,.2);border-top-color:var(--accent);animation:spin .8s linear infinite}
    @keyframes spin{to{transform:rotate(1turn)}}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="row" style="justify-content:space-between">
        <div>
          <h1>NDVI Predictor (Web)</h1>
          <div class="sub">Uploads NIR + Red images to your FastAPI and shows the model's prediction.</div>
        </div>
        <div class="status"><span id="srvdot" class="dot warn"></span><span id="srvtext" class="hint">Checking server…</span></div>
      </div>

      <div class="grid">
        <div class="panel">
          <label for="api">API base URL</label>
          <input id="api" type="text" value="http://localhost:8000" spellcheck="false" />
          <div class="hint mt8">Use <b>http://10.0.2.2:8000</b> if you're testing from an Android emulator. For remote servers, ensure CORS allows your origin.</div>
        </div>

        <div class="panel">
          <label>Choose channel images</label>
          <div class="filebox">
            <div class="file">
              <span class="pill ghost">NIR</span>
              <span id="nirName" class="name">No file</span>
              <label class="pick">
                <input id="nir" type="file" accept="image/*" />Pick
              </label>
            </div>
            <div class="file">
              <span class="pill ghost">Red</span>
              <span id="redName" class="name">No file</span>
              <label class="pick">
                <input id="red" type="file" accept="image/*" />Pick
              </label>
            </div>
          </div>
          <div class="mt12 row">
            <button id="go" disabled>Predict</button>
            <div id="busy" class="row hint" style="display:none;gap:8px"><span class="spin"></span> Posting images…</div>
          </div>
        </div>
      </div>

      <div id="out" class="results"></div>
    </div>

    <div class="hint mt16">Tip: Make sure your server is running with <code>uvicorn server:app --host 0.0.0.0 --port 8000 --reload</code>.</div>
  </div>

<script>
(() => {
  const $ = (q) => document.querySelector(q);
  const api = $('#api');
  const nir = $('#nir');
  const red = $('#red');
  const nirName = $('#nirName');
  const redName = $('#redName');
  const btn = $('#go');
  const out = $('#out');
  const busy = $('#busy');
  const srvdot = $('#srvdot');
  const srvtext = $('#srvtext');

  function setServerStatus(kind, text){
    srvdot.className = 'dot ' + kind; srvtext.textContent = text;
  }

  async function ping(){
    setServerStatus('warn','Checking server…');
    try{
      const r = await fetch(api.value.replace(/\/$/, '') + '/');
      if(!r.ok) throw new Error('bad status');
      const j = await r.json();
      if(j && j.status === 'ok') setServerStatus('ok','Server OK');
      else setServerStatus('warn','Server reachable');
    }catch(e){ setServerStatus('bad','Can\'t reach server'); }
  }

  api.addEventListener('change', ping);
  window.addEventListener('load', ping);

  function updateBtn(){ btn.disabled = !(nir.files?.length && red.files?.length); }
  nir.addEventListener('change', () => { nirName.textContent = nir.files?.[0]?.name || 'No file'; updateBtn(); });
  red.addEventListener('change', () => { redName.textContent = red.files?.[0]?.name || 'No file'; updateBtn(); });

  function renderResult(data){
    if(data.error){
      out.innerHTML = `<div class="error"><b>Error:</b> ${escapeHtml(data.error)}</div>`; return;
    }
    const pred = data.prediction ?? '—';
    const probs = data.probabilities || {};
    const rows = Object.keys(probs).map(k => {
      const p = probs[k] * 100;
      return `<div class="mt12"><div class="row" style="justify-content:space-between"><div>${escapeHtml(k)}</div><div class="hint">${p.toFixed(1)}%</div></div><div class="bar"><div style="width:${Math.max(0, Math.min(100, p))}%"></div></div></div>`;
    }).join('');

    out.innerHTML = `
      <div class="panel">
        <div class="row" style="align-items:center;gap:10px">
          <span class="pill">Prediction</span>
          <div style="font-weight:800;font-size:20px">${escapeHtml(pred)}</div>
        </div>
        ${rows || '<div class="hint mt8">No probability vector returned.</div>'}
      </div>`;
  }

  function escapeHtml(s){return String(s).replace(/[&<>"']/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]))}

  btn.addEventListener('click', async () => {
    if(btn.disabled) return;
    out.innerHTML = '';
    busy.style.display = 'flex';
    btn.disabled = true;
    try{
      const form = new FormData();
      form.append('nir_image', nir.files[0]);
      form.append('red_image', red.files[0]);
      const r = await fetch(api.value.replace(/\/$/, '') + '/predict', { method:'POST', body: form });
      const data = await r.json();
      renderResult(data);
    }catch(e){
      renderResult({error: e.message || String(e)});
    }finally{
      busy.style.display = 'none';
      btn.disabled = !(nir.files?.length && red.files?.length);
    }
  });
})();
</script>
</body>
</html>
